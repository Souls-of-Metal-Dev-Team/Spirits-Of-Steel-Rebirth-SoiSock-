[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/Elements/SaveEntry.cs" id="1_save"]

[node name="SaveEntry" type="HBoxContainer" node_paths=PackedStringArray("name_label", "load_button", "delete_button")]
theme_override_constants/separation = 10
script = ExtResource("1_save")
name_label = NodePath("Name")
load_button = NodePath("Load")
delete_button = NodePath("Delete")

[node name="Name" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="Load" type="Button" parent="."]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
text = "Load"

[node name="Delete" type="Button" parent="."]
modulate = Color(1, 0.4, 0.4, 1)
layout_mode = 2
text = "X"

[connection signal="pressed" from="Load" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Delete" to="." method="_on_delete_pressed"]
