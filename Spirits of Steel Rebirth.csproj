<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SpiritsofSteelRebirth</RootNamespace>
    <!-- UI text uses string interpolation; keep number formatting locale-independent like GDScript. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core and Tests are their own projects; keep the default glob from compiling them here. -->
    <Compile Remove="Core/**;Tests/**" />
    <ProjectReference Include="Core/Sosr.Core.csproj" />
  </ItemGroup>
</Project>